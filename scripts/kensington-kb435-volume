#!/usr/bin/env bash
set -euo pipefail

# Volume control for the media keys emitted by the Kensington KB435 keyboard.
if ! command -v wpctl > /dev/null; then
  printf 'Required volume command is not installed: wpctl\n' >&2
  exit 1
fi

case "${1:-}" in
  down)
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    ;;
  up)
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    ;;
  mute)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
  *)
    printf 'Usage: %s {down|up|mute}\n' "${0##*/}" >&2
    exit 2
    ;;
esac
