#!/usr/bin/env bash
set -euo pipefail

if ! command -v rofi > /dev/null; then
  printf 'Rofi is required for the graphical power confirmation.\n' >&2
  exit 1
fi

selection="$(printf 'Power off\nRestart\nSleep\nLog out\nCancel\n' | \
  rofi -dmenu -no-custom -selected-row 0 -p 'Power menu')" || exit 0

case "$selection" in
  'Sleep')
    systemctl suspend
    ;;
  'Log out')
    hyprctl dispatch exit
    ;;
  'Restart')
    systemctl reboot
    ;;
  'Power off')
    systemctl poweroff
    ;;
  'Cancel'|'')
    exit 0
    ;;
  *)
    printf 'Refusing unknown power action: %s\n' "$selection" >&2
    exit 1
    ;;
esac
