#!/usr/bin/env bash
set -euo pipefail

user_name="${1:-mb}"
shell_path="/usr/bin/zsh"

if (( EUID != 0 )); then
  printf 'Run with sudo: sudo %s [user]\n' "$0" >&2
  exit 1
fi

if ! getent passwd "$user_name" > /dev/null; then
  printf 'User does not exist: %s\n' "$user_name" >&2
  exit 1
fi

if [[ ! -x "$shell_path" ]]; then
  printf 'Zsh is not installed at %s. Install packages/20-shell.txt first.\n' "$shell_path" >&2
  exit 1
fi

usermod --shell "$shell_path" "$user_name"
printf 'Set %s login shell to %s\n' "$user_name" "$shell_path"
